<div class="menu-backdrop" aria-hidden="true"></div>
<script>
    function TURN()
    {
        const modal = document.querySelector(".custom-modal[data-modal-type='notifications']");
        const dot   = document.getElementById('unreadNotifications');
        if (!modal || !dot) return;

        const panel = modal.querySelector('.notifications-panel');
        if (!panel) { dot.classList.remove('active'); return; }

        const hasAny = panel.querySelector('.notif-item') !== null;
        if (!hasAny) { dot.classList.remove('active'); return; }

        const hasUnread = panel.querySelector('.notif-item.unread') !== null;
        if (!hasUnread) { dot.classList.remove('active'); return; }

        dot.classList.add('active');
    }

    function RNL() // Reset notification list.
    {
        const modal = document.querySelector("[data-modal-type='notifications']");
        if (!modal) return;

        const list = modal.querySelector('.notifications-panel');
        if (!list) return;

        list.innerHTML = '';
    };

    async function LNL() // Load notification list.
    {
        RNL(); // Reset the Notification list
        try
        {
            const res = await fetch('/Home/Endpoints/Initloadnotifications', { method: 'POST' });
            if (!res.ok) throw new Error('Network error loading notifications.');
            const data = await res.json();

            if (!data.ok) { alert(data.message || 'Failed to load notifications.'); return; }

            const modal = document.querySelector("[data-modal-type='notifications']");
            if (!modal) return;

            const list = modal.querySelector('.notifications-panel');
            if (!list) return;

            if (data.html && data.html.trim().length > 0) { list.innerHTML = data.html; }
            TURN();
        }
        catch (err) {
            console.error('LNL failed:', err);
            alert('Error loading notifications: ' + (err.message || 'Unknown error'));
        }
    }

    window.NMON = async function ()
    {
        toggleGlobalSpinner(true);
        try {
            await LNL(); // simply load list
            openModalByType('notifications');
        }
        catch (err) {
            console.error('NMON failed:', err);
            alert('Error loading notifications: ' + (err.message || 'Unknown error'));
        }
        finally {
            toggleGlobalSpinner(false);
        }
    };

    document.addEventListener('DOMContentLoaded', async () => {
        try {
            // Load current notifications silently
            if (typeof LNL === 'function') {
                await LNL();

                // Check unread count right after load
                const modal = document.querySelector("[data-modal-type='notifications']");
                if (modal) {
                    const unreadItems = modal.querySelectorAll('.notif-item.unread').length;
                    if (unreadItems > 0) {
                        const modalOpen = modal.classList.contains('show');
                        if (!modalOpen) playDing();
                    }
                }
            }
        } catch (err) {
            console.warn('Silent LNL preload failed:', err);
        }
    });
    let dingUnlocked = false;
    let dingAudio = new Audio('/assets/sounds/Nding.mp3');

    function unlockDingAudio() {
        if (dingUnlocked) return;

        // Attempt a silent play to unlock audio context
        dingAudio.muted = true;
        dingAudio.play().then(() => {
            dingAudio.pause();
            dingAudio.currentTime = 0;
            dingAudio.muted = false;
            dingUnlocked = true;
            console.log("🔓 Audio unlocked (user gesture detected)");

            // Remove all gesture listeners after unlock
            document.removeEventListener('pointerdown', unlockDingAudio);
            document.removeEventListener('keydown', unlockDingAudio);
            document.removeEventListener('mousemove', unlockDingAudio);
            document.removeEventListener('touchstart', unlockDingAudio);
        }).catch(err => {
            console.warn("Unlock failed:", err.message);
        });
    }

    // Attach to any reasonable human interaction
    document.addEventListener('pointerdown', unlockDingAudio);
    document.addEventListener('keydown', unlockDingAudio);
    document.addEventListener('mousemove', unlockDingAudio);
    document.addEventListener('touchstart', unlockDingAudio);
    function playDing() {
        if (!dingUnlocked) return; // skip if not unlocked yet
        try {
            dingAudio.currentTime = 0;
            dingAudio.play().catch(err => console.warn("Ding blocked:", err.message));
        } catch (err) {
            console.warn("Ding failed:", err.message);
        }
    }
</script>