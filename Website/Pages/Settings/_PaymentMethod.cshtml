@using App.Security
@{
    string modalId = Guid.NewGuid().ToString("N");
}
<div class="custom-modal" data-modal-type="paymentmethod" data-modal-id="@modalId">
    <div class="custom-modal-content" role="dialog" aria-modal="true" aria-labelledby="paymentmodaltitle_@modalId">
        <div class="custom-modal-header" style="display:flex;justify-content:space-between;align-items:center;">
            <input type="hidden" class="PaymentModalId" value="@modalId" />
            <table style="width:100%;">
                <tr>
                    <td style="text-align:center;width:90%;">
                        <h5 id="paymentmodaltitle_@modalId">
                            <i class="fa-solid fa-credit-card"></i>&nbsp;Select Payment Method
                        </h5>
                    </td>
                    <td style="text-align:right;width:10%;">
                        <button id="PMMBTNCLS" class="btn btn-close" aria-label="Close" onclick="PMMC();">×</button>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" style="text-align:left;">
                        <button type="button" class="btn btn-outline" onclick="PMMSAF(this);">+ Add Payment Method</button>
                    </td>
                </tr>
            </table>
        </div>
        <div id="PMM_EMPTY_@modalId" class="empty-state" style="display:none;">
            <p>No saved payment methods yet.</p>
        </div>
        <div class="custom-modal-body" id="PMMBODY_@modalId" style="display:flex;flex-direction:column;gap:0.5rem;">
            <div id="PMM_LIST_@modalId" style="display:none;flex-direction:column;gap:0.5rem;"></div>

            <div id="PMM_ADDNEW_ROW_@modalId"
                 style="display:none;border:1px solid var(--color-primary);border-radius:8px;padding:0.75rem;">
                <table style="width:100%;border-collapse:collapse;">
                    <tr><td><label><b>Payment Type</b></label></td></tr>
                    <tr>
                        <td>
                            <select id="PMM_Type_@modalId" class="input-text" style="width:100%;"
                                    onchange="PMM_OnTypeChange('@modalId');">
                                <option value="" disabled selected hidden>-- Select Type --</option>
                                @foreach (var t in App.Helper.Table.PaymentType.PaymentTypeOptions())
                                {
                                    <option value="@t.Value">@t.Text</option>
                                }
                            </select>
                        </td>
                    </tr>

                    <tbody id="PMM_DETAILS_@modalId" style="display:none;">
                        <tr data-field="provider"><td><label><b>Provider</b></label></td></tr>
                        <tr data-field="provider">
                            <td>
                                <select id="PMM_Provider_@modalId" class="input-text" style="width:100%;" disabled
                                        onchange="PMM_OnProviderChange('@modalId');">
                                    <option value="" disabled selected hidden>-- Select Provider --</option>
                                </select>
                            </td>
                        </tr>

                        <tr data-field="display"><td><label><b>Display Name</b></label></td></tr>
                        <tr data-field="display">
                            <td>
                                <input id="PMM_DisplayName_@modalId" class="input-text"
                                       placeholder="My Visa / PayPal / IOU" style="width:100%; font-size:1rem;" required />
                            </td>
                        </tr>

                        <!-- NEW: Bank Account (NZ) -->
                        <tr data-field="account"><td><label><b>Bank Account (NZ)</b></label></td></tr>
                        <tr data-field="account">
                            <td>
                                <input id="PMM_Account_@modalId" class="input-text"
                                       placeholder="BB-bbbb-AAAAAAA-SSS" style="width:100%;" />
                            </td>
                        </tr>

                        <tr data-field="token"><td><label><b>Vault Token / Reference</b></label></td></tr>
                        <tr data-field="token">
                            <td>
                                <input id="PMM_Token_@modalId" class="input-text"
                                       placeholder="tok_xxx / payer id / bank ref"
                                       style="width:100%;" />
                            </td>
                        </tr>

                        <tr data-field="brandset">
                            <td>
                                <table style="width:100%;border-collapse:collapse;">
                                    <tr>
                                        <td style="width:50%;">
                                            <input id="PMM_Brand_@modalId" class="input-text"
                                                   placeholder="Brand (Visa / ANZ)" style="width:100%;" />
                                        </td>
                                        <td style="width:50%;">
                                            <input id="PMM_Last4_@modalId" class="input-text" maxlength="4"
                                                   placeholder="Last 4 (optional)" style="width:100%;" />
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <tr>
                            <td id="PMM_Warning_@modalId"
                                style="display:none;color:var(--color-warning);font-size:0.9rem;padding-top:0.25rem;"></td>
                        </tr>
                    </tbody>

                    <tr>
                        <td style="text-align:right;padding-top:0.75rem;">
                            <button class="btn btn-primary" type="button" onclick="PMM_AcceptAdd('@modalId');">Accept</button>
                            <button class="btn btn-secondary" type="button" onclick="PMM_CancelAdd('@modalId');">Cancel</button>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="custom-modal-footer" style="display:flex;justify-content:space-between;align-items:center;">
            <span>&nbsp;</span>
        </div>
    </div>
</div>
