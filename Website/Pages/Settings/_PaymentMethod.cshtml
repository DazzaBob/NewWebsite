@using App.Security
@{
    string modalId = Guid.NewGuid().ToString("N");
}
<div class="custom-modal" data-modal-type="paymentmethod" data-modal-id="@modalId">
    <div class="custom-modal-content" role="dialog" aria-modal="true" aria-labelledby="paymentmodaltitle_@modalId">
        <div class="custom-modal-header" style="display:flex;justify-content:space-between;align-items:center;">
            <input type="hidden" class="PaymentModalId" value="@modalId" />
            <table style="width:100%;">
                <tr>
                    <td style="text-align:center;width:90%;">
                        <h5 id="paymentmodaltitle_@modalId">
                            <i class="fa-solid fa-credit-card"></i>&nbsp;Select Payment Method
                        </h5>
                    </td>
                    <td style="text-align:right;width:10%;">
                        <button id="PMMBTNCLS" class="btn btn-close" aria-label="Close" onclick="PMMC();">×</button>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" style="text-align:left;">
                        <button type="button" class="btn btn-outline" onclick="PMMSAF(this);">+ Add Payment Method</button>
                    </td>
                </tr>
            </table>
        </div>

        <div id="PMM_EMPTY_@modalId" class="empty-state" style="display:none;">
            <p>No saved payment methods yet.</p>
        </div>

        <div class="custom-modal-body" id="PMMBODY_@modalId" style="display:flex;flex-direction:column;gap:0.5rem;">
            <div id="PMM_LIST_@modalId" style="display:none;flex-direction:column;gap:0.5rem;"></div>

            <div id="PMM_ADDNEW_ROW_@modalId"
                 style="display:none;border:1px solid var(--color-primary);border-radius:8px;padding:0.75rem;">
                <table style="width:100%;border-collapse:collapse;">
                    <tr><td><label><b>Payment Type</b></label></td></tr>
                    <tr>
                        <td>
                            <select id="PMM_Type_@modalId" class="input-text" style="width:100%;"
                                    onchange="PMM_OnTypeChange('@modalId');">
                                <option value="" disabled selected hidden>-- Select Type --</option>
                                @foreach (var t in App.Helper.Table.PaymentType.PaymentTypeOptions())
                                {
                                    <option value="@t.Value">@t.Text</option>
                                }
                            </select>
                        </td>
                    </tr>

                    <tbody id="PMM_DETAILS_@modalId" style="display:none;">
                        <tr data-field="provider"><td><label><b>Provider</b></label></td></tr>
                        <tr data-field="provider">
                            <td>
                                <select id="PMM_Provider_@modalId" class="input-text" style="width:100%;" disabled
                                        onchange="PMM_OnProviderChange('@modalId');">
                                    <option value="" disabled selected hidden>-- Select Provider --</option>
                                </select>
                            </td>
                        </tr>

                        <tr data-field="display"><td><label><b>Display Name</b></label></td></tr>
                        <tr data-field="display">
                            <td>
                                <input id="PMM_DisplayName_@modalId" class="input-text"
                                       placeholder="My Visa / PayPal / IOU" style="width:100%; font-size:1rem;" required />
                            </td>
                        </tr>

                        <!-- NEW: Bank Account (NZ) -->
                        <tr data-field="account"><td><label><b>Bank Account (NZ)</b></label></td></tr>
                        <tr data-field="account">
                            <td>
                                <input id="PMM_Account_@modalId" class="input-text"
                                       placeholder="BB-bbbb-AAAAAAA-SSS" style="width:100%;" />
                            </td>
                        </tr>

                        <tr data-field="token"><td><label><b>Vault Token / Reference</b></label></td></tr>
                        <tr data-field="token">
                            <td>
                                <input id="PMM_Token_@modalId" class="input-text"
                                       placeholder="tok_xxx / payer id / bank ref"
                                       style="width:100%;" />
                            </td>
                        </tr>

                        <tr data-field="brandset">
                            <td>
                                <table style="width:100%;border-collapse:collapse;">
                                    <tr>
                                        <td style="width:50%;">
                                            <input id="PMM_Brand_@modalId" class="input-text"
                                                   placeholder="Brand (Visa / ANZ)" style="width:100%;" />
                                        </td>
                                        <td style="width:50%;">
                                            <input id="PMM_Last4_@modalId" class="input-text" maxlength="4"
                                                   placeholder="Last 4 (optional)" style="width:100%;" />
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <tr>
                            <td id="PMM_Warning_@modalId"
                                style="display:none;color:var(--color-warning);font-size:0.9rem;padding-top:0.25rem;"></td>
                        </tr>
                    </tbody>

                    <tr>
                        <td style="text-align:right;padding-top:0.75rem;">
                            <button class="btn btn-primary" type="button" onclick="PMM_AcceptAdd('@modalId');">Accept</button>
                            <button class="btn btn-secondary" type="button" onclick="PMM_CancelAdd('@modalId');">Cancel</button>
                        </td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="custom-modal-footer" style="display:flex;justify-content:space-between;align-items:center;">
            <span>&nbsp;</span>
        </div>
    </div>
</div>
<script type="text/javascript">
    (() => {

        // ===== Namespace Setup =====
        window.PMM = window.PMM || {};

        // ===== Utility Helpers =====
        function showTBody(tb, on = true) { if (tb) tb.style.display = on ? 'table-row-group' : 'none'; }
        function showRow(tr, on = true) { if (tr) tr.style.display = on ? 'table-row' : 'none'; }
        function hideAllCtxRows(details) {
            details.querySelectorAll('tr[data-field]').forEach(tr => showRow(tr, false));
        }

        function PMM_Notify(msg) {
            alert(msg);
        }

        window.PMM_LoadList = async function (modalId, initial = false) {
        const m = document.querySelector(`[data-modal-id='${modalId}']`);
        if (!m) return alert('PMM_LoadList: modal not found');

        const list = m.querySelector('#PMM_LIST_' + modalId);
        const empty = m.querySelector('#PMM_EMPTY_' + modalId);
        const addRow = m.querySelector('#PMM_ADDNEW_ROW_' + modalId);

        if (initial) console.log('PMM_LoadList starting (initial load)');

        try {
            const res = await fetch('/Endpoints/GetPaymentMethods', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ModalId: modalId })
            });
            if (!res.ok) { alert(`Server returned ${res.status} ${res.statusText}`); return; }
            const data = await res.json();

            if (!data.ok) { alert(data.msg || 'Failed to load payment methods.'); return; }
            if (list) {
                list.innerHTML = ''; // clear any existing content
                if (data.html && data.html.trim().length > 0) {
                    list.innerHTML = data.html;
                    list.style.display = 'flex';
                    if (empty) empty.style.display = 'none';
                } else {
                    list.style.display = 'none';
                    if (empty) empty.style.display = '';
                }
            }

            if (addRow) addRow.style.display = 'none';
        }
        catch (err) {
            alert('Network or server error while loading payment methods.');
            console.error(err);
        }
    };
        // ===== Provider Rules (NZ-aware) =====
        window.PMM.PROVIDER_RULES = Object.freeze({
            STRIPE: {
                show: ['token', 'brandset'],
                labels: { token: 'Vault token', brand: 'Card brand', last4: 'Last 4' },
                validate: f => (!f.Token ? 'Card token missing.' : !f.Brand ? 'Card brand required.' : null)
            },
            ETFPOS: {
                show: ['token'],
                labels: { token: 'Gateway transaction reference' },
                validate: f => (!f.Token ? 'Transaction reference required.' : null)
            },
            ONLINEWALLET: {
                show: ['token'],
                labels: { token: 'Wallet payer/reference ID' },
                validate: f => (!f.Token ? 'Wallet reference required.' : null)
            },
            DD: {
                show: ['account', 'token', 'brandset'],
                labels: {
                    account: 'Bank account (BB-bbbb-AAAAAAA-SSS)',
                    token: 'Mandate / Authority reference',
                    brand: 'Bank name',
                    last4: 'Account suffix (2–3 digits)'
                },
                validate: f => {
                    const accPattern = /^\d{2}-\d{4}-\d{6,8}-\d{2,3}$/;
                    if (!f.Account) return 'Bank account required.';
                    if (!accPattern.test(f.Account)) return 'Invalid NZ bank account format.';
                    if (!f.Token) return 'Mandate reference required.';
                    if (!f.Brand) return 'Bank name required.';
                    return null;
                }
            },
            AP: {
                show: ['token'],
                labels: { token: 'Payment reference for Particulars/Code/Reference' },
                validate: f => (!f.Token ? 'Payment reference required.' : null)
            },
            INVOICE: { show: [], labels: {}, validate: () => null },
            IOU: { show: ['token'], labels: { token: 'Deferred payment reference' }, validate: f => (!f.Token ? 'Reference required.' : null) },
            CASH: { show: [], labels: {}, validate: () => null },
            BALANCE: { show: [], labels: {}, validate: () => null }
        });

        // ===== Apply Dynamic Field Labels =====
        function PMM_ApplyFieldLabels(modalId, rule) {
            const m = document.querySelector(`[data-modal-id='${modalId}']`);
            if (!m || !rule) return;
            const set = (id, text) => {
                const el = m.querySelector(id);
                if (el && text) el.placeholder = text;
            };
            set('#PMM_Token_' + modalId, rule.labels?.token || 'Reference / Token');
            set('#PMM_Brand_' + modalId, rule.labels?.brand || 'Brand / Bank');
            set('#PMM_Last4_' + modalId, rule.labels?.last4 || 'Last 4 / Suffix');
            set('#PMM_Account_' + modalId, rule.labels?.account || 'BB-bbbb-AAAAAAA-SSS');
        }

        // ===== Type Change Handler =====
        window.PMM_OnTypeChange = async function (modalId) {
            const m = document.querySelector(`[data-modal-id='${modalId}']`);
            if (!m) return;

            const details = m.querySelector('#PMM_DETAILS_' + modalId);
            const typeSel = m.querySelector('#PMM_Type_' + modalId);
            const provSel = m.querySelector('#PMM_Provider_' + modalId);

            if (details) { showTBody(details, false); hideAllCtxRows(details); }
            if (!typeSel || !typeSel.value) return;

            if (details) {
                showTBody(details, true);
                details.querySelectorAll('tr[data-field="provider"], tr[data-field="display"]').forEach(tr => showRow(tr, true));
            }

            if (provSel) {
                provSel.disabled = true;
                provSel.innerHTML = '<option value="" disabled selected hidden>-- Loading --</option>';
                provSel.onchange = null;
            }

            try {
                const res = await fetch('/Endpoints/ProvidersByType', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ TypeId: parseInt(typeSel.value, 10) })
                });

                const data = await res.json();
                if (!provSel) return;

                provSel.innerHTML = '';
                const placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = '-- Select Provider --';
                placeholder.disabled = true;
                placeholder.selected = true;
                provSel.appendChild(placeholder);

                if (!data.ok || !Array.isArray(data.providers) || data.providers.length === 0) {
                    placeholder.textContent = '-- No Providers --';
                    provSel.disabled = true;
                    PMM_Notify('No providers available for this type.');
                    return;
                }

                data.providers.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.id;
                    opt.textContent = p.name;
                    if (p.code) opt.dataset.code = p.code.toUpperCase();
                    provSel.appendChild(opt);
                });

                provSel.selectedIndex = 0;
                provSel.disabled = false;
                PMM_ClearInputs(modalId);
                provSel.onchange = () => PMM_OnProviderChange(modalId);

            } catch {
                PMM_Notify('Failed to load providers.');
                if (provSel) provSel.disabled = true;
            }
        };

        // ===== Provider Change Handler =====
        window.PMM_OnProviderChange = function (modalId) {
            const m = document.querySelector(`[data-modal-id='${modalId}']`);
            if (!m) return;
            const details = m.querySelector('#PMM_DETAILS_' + modalId);
            const provSel = m.querySelector('#PMM_Provider_' + modalId);
            if (!details || !provSel || !provSel.value) return;

            PMM_ClearInputs(modalId);
            hideAllCtxRows(details);
            details.querySelectorAll('tr[data-field="provider"], tr[data-field="display"]').forEach(tr => showRow(tr, true));

            const code = provSel.selectedOptions[0]?.dataset?.code || '';
            const rule = window.PMM.PROVIDER_RULES[code] || null;
            if (!rule) return;

            (rule.show || []).forEach(f => {
                details.querySelectorAll(`tr[data-field="${f}"]`).forEach(tr => showRow(tr, true));
            });
            PMM_ApplyFieldLabels(modalId, rule);
        };

        // ===== Accept Button Logic =====
        window.PMM_AcceptAdd = async function (modalId) {
        const m = document.querySelector(`[data-modal-id='${modalId}']`);
        if (!m) return;

        const provSel = m.querySelector('#PMM_Provider_' + modalId);
        const code = provSel?.selectedOptions[0]?.dataset?.code || '';
        const rule = window.PMM.PROVIDER_RULES[code] || null;

        const fields = {
            TypeId: parseInt(m.querySelector('#PMM_Type_' + modalId)?.value || '0', 10),
            ProviderId: parseInt(provSel?.value || '0', 10),
            DisplayName: m.querySelector('#PMM_DisplayName_' + modalId)?.value.trim() || '',
            Token: m.querySelector('#PMM_Token_' + modalId)?.value.trim() || '',
            Brand: m.querySelector('#PMM_Brand_' + modalId)?.value.trim() || '',
            Last4: m.querySelector('#PMM_Last4_' + modalId)?.value.trim() || '',
            Account: m.querySelector('#PMM_Account_' + modalId)?.value.trim() || '',
            ModalId: modalId || '',
        };

        if (!fields.TypeId || !fields.ProviderId) { PMM_Notify('Please select a payment type and provider.'); return; }
        if (!fields.DisplayName) { PMM_Notify('Please enter a display name for this payment method.'); return; }

        const err = rule?.validate?.(fields) || null;
        if (err) { PMM_Notify(err); return; }

        let data; // ← move this here so both try blocks can see it
        try {
            const res = await fetch('/Endpoints/AddPaymentMethod', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(fields) });
            if (!res.ok) { PMM_Notify(`Server returned ${res.status} ${res.statusText}`); return; }
            data = await res.json();
            if (!data.ok) { PMM_Notify(data.msg || 'Failed to save payment method.'); return; }
        }
        catch (e) {
            PMM_Notify('Network or server error while saving.');
            return;
        }

        // Now data is accessible here
        try {
            const list   = m.querySelector('#PMM_LIST_' + modalId);
            const addRow = m.querySelector('#PMM_ADDNEW_ROW_' + modalId);
            const empty  = m.querySelector('#PMM_EMPTY_' + modalId);

            if (list && data && data.html) {
                if (empty) empty.style.display = 'none';
                list.insertAdjacentHTML('beforeend', data.html);
                list.style.display = 'flex';
            } 
            if (addRow) addRow.style.display = 'none';
        }
        catch (e) {
            alert('AcceptAdd exception: ' + e.message);
        }
    };
        // ===== Misc Helpers =====
        window.PMMSAF = btn => {
            const modal = btn.closest('.custom-modal');
            if (!modal) return;
            PMM_ShowAdd(modal.dataset.modalId);
        };

        window.PMM_ShowAdd = modalId => {
            const m = document.querySelector(`[data-modal-id='${modalId}']`);
            if (!m) return;
            const addRow = m.querySelector('#PMM_ADDNEW_ROW_' + modalId);
            const list = m.querySelector('#PMM_LIST_' + modalId);
            const empty = m.querySelector('#PMM_EMPTY_' + modalId);
            if (list) list.style.display = 'none';
            if (empty) empty.style.display = 'none';
            if (addRow) addRow.style.display = '';
            PMM_ResetForm(modalId);
            const first = m.querySelector('#PMM_Type_' + modalId);
            if (first) first.focus();
        };

        window.PMM_ResetForm = modalId => {
            const m = document.querySelector(`[data-modal-id='${modalId}']`);
            if (!m) return;
            const details = m.querySelector('#PMM_DETAILS_' + modalId);
            const typeSel = m.querySelector('#PMM_Type_' + modalId);
            const provSel = m.querySelector('#PMM_Provider_' + modalId);
            if (typeSel) typeSel.value = '';
            if (provSel) {
                provSel.innerHTML = '<option value="" disabled selected hidden>-- Select Provider --</option>';
                provSel.disabled = true;
                provSel.onchange = null;
            }
            ['DisplayName', 'Token', 'Brand', 'Last4', 'Account'].forEach(f => {
                const el = m.querySelector('#PMM_' + f + '_' + modalId);
                if (el) el.value = '';
            });
            if (details) { showTBody(details, false); hideAllCtxRows(details); }
        };

        window.PMM_ClearInputs = modalId => {
            const m = document.querySelector(`[data-modal-id='${modalId}']`);
            if (!m) return;
            ['DisplayName', 'Token', 'Brand', 'Last4', 'Account'].forEach(f => {
                const el = m.querySelector('#PMM_' + f + '_' + modalId);
                if (el) el.value = '';
            });
        };

        window.PMDPC = async function (btn) {
          if (!confirm('Delete this payment method?')) return;

          const card = btn.closest('.payment-card'); if (!card) { alert('Unable to locate payment card.'); return; }
          const radio = card.querySelector('.payment-radio');
          const id = parseInt(radio?.value || '0', 10);
          if (!id) { alert('Invalid payment ID.'); return; }
          try { const res = await fetch('/Endpoints/DeletePaymentMethod', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ PaymentId: id }) });
            const data = await res.json();
            if (!res.ok || !data.ok) { alert(data.msg || 'Failed to delete payment method.'); return; }
            card.remove();
          } catch { alert('Network or server error while deleting.'); }
        };

        window.PMSEPC = function (btn) {
        const card = btn.closest('.payment-card');
        if (!card) { alert('Unable to locate payment card.'); return; }

        const label = card.querySelector('.payment-label');
        const input = card.querySelector('.payment-edit-input');
        const normalActions = card.querySelector('.payment-actions');
        const editActions = card.querySelector('.payment-actions-edit');

        if (label) label.style.display = 'none';
        if (input) input.style.display = '';
        if (normalActions) normalActions.style.display = 'none';
        if (editActions) editActions.style.display = '';
        };

        window.PMCEC = function (btn) {
          const card = btn.closest('.payment-card');
          if (!card) return;

          const label = card.querySelector('.payment-label');
          const input = card.querySelector('.payment-edit-input');
          const normalActions = card.querySelector('.payment-actions');
          const editActions = card.querySelector('.payment-actions-edit');

          if (label) label.style.display = '';
          if (input) input.style.display = 'none';
          if (normalActions) normalActions.style.display = '';
          if (editActions) editActions.style.display = 'none';
        };

        window.PMSEV = async function (btn) {
        const card = btn.closest('.payment-card');
        if (!card) { alert('Unable to locate payment card.'); return; }

        const id = parseInt(card.querySelector('.payment-radio')?.value || '0', 10);
        const newName = card.querySelector('.payment-edit-input')?.value.trim() || '';

        if (!id) { alert('Invalid payment ID.'); return; }
        if (!newName) { alert('Display name cannot be empty.'); return; }

        try {
        const res = await fetch('/Endpoints/EditPaymentMethod', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ PaymentId: id, DisplayName: newName })
        });

        const data = await res.json();
        if (!res.ok || !data.ok) {
            alert(data.msg || 'Failed to update payment method.');
            return;
        }

        const label = card.querySelector('.payment-label');
        if (label) label.textContent = newName;

        window.PMCEC(btn); // exit edit mode
        } catch {
        alert('Network or server error while saving.');
        }
    };

        window.PMSD = async function (radio) {
        const id = parseInt(radio?.value || '0', 10);
        if (!id) { alert('Invalid payment ID.'); return; }

        try {
        const res = await fetch('/Endpoints/SetDefaultPayment', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ PaymentId: id }) });

        const data = await res.json();
        if (!res.ok || !data.ok) { alert(data.msg || 'Failed to set default payment method.'); return; }

        // Update UI: hide delete on default, show on others
        document.querySelectorAll('.payment-card').forEach(card => {
            const r = card.querySelector('.payment-radio');
            const del = card.querySelector('.payment-delete');
            const isThis = parseInt(r?.value || '0', 10) === id;
            if (r) r.checked = isThis;
            if (del) del.style.display = isThis ? 'none' : 'block';
        });
        } catch { alert('Network or server error while setting default.'); }
    };

        window.PMMC = async function () {
          const modal = document.querySelector("[data-modal-type='paymentmethod']");
          if (!modal) return;
          const modalId = modal.dataset.modalId;

          // just reset and reload using existing helpers
          if (typeof PMM_ResetForm === 'function') PMM_ResetForm(modalId);
          if (typeof PMM_LoadList === 'function') await PMM_LoadList(modalId, false);

          // close the modal
          if (typeof closeModalByType === 'function') closeModalByType('paymentmethod');
        };

        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.querySelector(`[data-modal-id='@modalId']`);
            if (!modal) return;
            const path = window.location.pathname.toLowerCase();
            modal.dataset.context =
                path.includes('pickitup') ? 'pickitup' :
                path.includes('settings') ? 'settings' : 'default';
            PMM_LoadList('@modalId', true);
        });

        window.PMM_CFJ = async function () {
          try {
            const modal = document.querySelector("[data-modal-type='paymentmethod']");
            if (!modal) return;

            // Find the selected payment radio
            const selected = modal.querySelector("input[name^='selectedPayment_']:checked");

            if (!selected) {
              alert("Please select a payment method first.");
              return;
            }

            const paymentId = selected.value;
            const pricingEl = document.getElementById("PIUpricingJSON");
            if (!pricingEl) {
              alert("Missing pricing information.");
              return;
            }

            const pricing = JSON.parse(pricingEl.value);
            const payload = { PaymentId: parseInt(paymentId), Pricing: JSON.stringify(pricing) };
            const res = await fetch("/Endpoints/ConfirmAndPay", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
            const data = await res.json();
            if (!data.ok) { alert(data.msg || "Payment confirmation failed."); return; }

            closeModalByType("paymentmethod");

            try {
              const res = await fetch("/Endpoints/Allocate", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ JobId: data.job_id })
              });

              // Try to decode JSON even if the server returned an error
              let alloc = {};
              try { alloc = await res.json(); } catch {}

              // Handle network or server-side errors
              if (!res.ok || !alloc.ok) {
                const msg =
                  alloc.msg ||
                  (res.status >= 500
                    ? "Server error during allocation."
                    : "Allocation failed. Please try again.");
                alert(msg);
                return; // stop here, do not redirect
              }

              // Allocation succeeded — safe to redirect
              window.location.href = "/Orders/Current";

            } catch (e) {
              console.error("Allocator trigger failed:", e);
              alert("Unexpected allocation error. Please try again later.");
            }
          } catch (err) {
            console.error("Confirm & Pay error", err);
            alert("Unexpected error during confirmation.");
          }
        };

    })();
</script>
