@page
@model Website.Pages.User.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard Home";
    Layout = "_Layout";
    System.Data.DataTable dt = Model.GetLocationModalDataTable();
}
@section StatusStrip { }

<form id="addressForm">
    <div id="addressModal" class="custom-modal">
        <div class="custom-modal-content" role="dialog" aria-modal="true" aria-labelledby="addressModalTitle" tabindex="-1">
            <div class="custom-modal-header">
                <h5 id="addressModalTitle">Select Current Address</h5>
                <button id="addressClose" class="btn-close" aria-label="Close" onclick="closeAddressModal(); document.getElementById('addressModal').classList.remove('show');">×</button>
            </div>
            <div class="custom-modal-body">
            @if (dt == null || dt.Rows.Count == 0)
            {
                <div class="empty-state">
                    <p>No saved addresses yet.</p>
                </div>
            }
            else
            {
                @foreach (System.Data.DataRow row in dt.Rows)
                {
                    var id = Convert.ToInt32(row["ID"]);
                    var isDefault = Convert.ToInt32(row["ISDEFAULT"]) == 1;
                    var label = (row["LABEL"]?.ToString() ?? string.Empty).Trim();

                    var streetNo = row["STREET_NUMBER"]?.ToString() ?? string.Empty;
                    var streetName = row["STREET_NAME"]?.ToString() ?? string.Empty;
                    var street = $"{streetNo} {streetName}".Trim();

                    var locality = row["LOCALITY_NAME"]?.ToString() ?? string.Empty;
                    var place = row["PLACE_NAME"]?.ToString() ?? string.Empty;
                    var placeLine = string.IsNullOrWhiteSpace(locality) ? place : $"{locality}, {place}";
                    <div class="card address-card" style="display:flex; justify-content:space-between; align-items:center; padding:0.5rem 1rem;">
                        <div class="address-content" style="flex:1;">
                            <div class="address-option-row">
                                <input class="address-radio" name="selectedAddress" onclick="UpdateDefaultAddress(this)" type="radio" id="addr_@id" value="@id" @(isDefault ? "checked" : null) />
                                <label class="address-label" for="addr_@id"><b>@label</b></label>
                            </div>
                            <div class="address-line">@street,&nbsp;@placeLine</div>
                        </div>
                        <div class="address-actions" style="margin-left:1rem;">
                            <button class="address-edit"><i class="fa-solid fa-pen"></i></button>
                            @if (isDefault)
                            {
                                        <button class="address-delete" onclick="DeleteAddressCard(this)" style="display:none;">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            }
                            else
                            {
                                        <button class="address-delete" onclick="DeleteAddressCard(this)" style="display:block;">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
                <div id="add-address-section" class="mt-3"><a id="add-address-link" href="#" role="button" tabindex="0" onclick="showaddaddresscard(); return false;">+ Add New Address</a></div>
                <div id="addaddresssection" class="card address-card" style="display:none">
                    <div id="add-address-card" class="add-address-form">
                        <div class="address-option-row"><label><b>New Address</b></label></div>
                            <div class="form-group mt-2">
                                <label for="newLabel">Label</label>
                                <input type="text" id="newLabel" class="form-control" placeholder="Home, Work, etc." />
                            </div>
                            <span>&nbsp;</span>
                            <div class="form-group mt-2" style="position:relative;">
                                <label for="NewAddressSearch">Search Address</label>
                                <input id="NewAddressSearch" class="input-text" autocomplete="off" placeholder="Start typing your address…" required />
                                <ul id="NewAutocompleteList" class="autocomplete-list" hidden></ul>
                                <input id="NewMapboxAddressJSON" type="hidden" />
                            </div>
                            <span>&nbsp;</span>
                            <div class="form-group mt-2">
                                <label for="NewAddressTypeID">Address Type</label>
                                 <select id="NewAddressTypeID" class="input-text" required>
                                    <option value="">-- Select address type --</option>
                                    @foreach (var item in Model.AddressTypeOptions)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                            <span>&nbsp;</span>
                            <div class="mt-3 d-flex gap-2">
                                <div style="display: flex; justify-content: space-between;">
                                    <div style="text-align: left;">
                                        <button id="saveNewAddress" type="button" class="btn btn-primary">Save</button>
                                    </div>
                                    <div style="text-align: right;">
                                        <button id="cancelNewAddress" type="button" class="btn btn-secondary" onclick="CloseNewAddressCard()">Cancel</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </div>
            <div class="custom-modal-footer">
                <button id="addressCancel" class="btn btn-secondary">Cancel</button>
                <button id="addressSave" type="submit" class="btn btn-primary">Set as current</button>
            </div>
        </div>
    </div>
</form>
    
<div class="dashboard-content">
@if (Model.UserRolesDT.Rows.Count > 1)
{
<div class="dashboard-card roles-card">
    <h3>Your Roles</h3>
    <div class="role-pills">
        @foreach (System.Data.DataRow dr in Model.UserRolesDT.Rows)
        {
            <a href="@(dr["ROUTE"])" class="pill">
                @dr["NAME"]
                <i class="@(dr["ICONCLASS"])" aria-hidden="true"></i>
            </a>
        }
    </div>
</div>
}
        <div class="dashboard-card">
            <h3>Manage Addresses</h3>
            <ul class="task-list">
                <li><a asp-page="/User/Addresses" class="btn">View / Edit Addresses</a></li>
                <li><a asp-page="/User/Addresses/Add" class="btn">Add New Address</a></li>
                <li><a asp-page="/User/Addresses/Delete" class="btn btn-outline-danger">Remove Address</a></li>
            </ul>
        </div>
        <div class="card-grid">
            <!-- 1. Account Balance -->
            <div class="dashboard-card">
                <h3>Account Balance</h3>
                <p>@Model.AccountBalance.ToString("C")</p>
            </div>

            <!-- 2. Recent Activity -->
            <div class="dashboard-card">
                <h3>Recent Activity</h3>
                <p>No recent activity.</p>
            </div>

            <!-- 3. Upcoming Tasks -->
            <div class="dashboard-card">
                <h3>Upcoming Tasks</h3>
                <p>No scheduled tasks.</p>
            </div>

            <!-- 4. Recommended Services -->
            <div class="dashboard-card">
                <h3>Recommended Services</h3>
                <p>No recommendations at this time.</p>
            </div>

            <!-- 5. Promotions & Offers -->
            <div class="dashboard-card">
                <h3>Promotions & Offers</h3>
                <p>No current promotions.</p>
            </div>

            <!-- 6. Recent Orders -->
            <div class="dashboard-card">
                <h3>Recent Orders</h3>
                <p>No orders yet.</p>
            </div>

            <!-- 7. Current Mode -->
            <div class="dashboard-card">
                <h3>Current Mode</h3>
                <p>No intent selected.</p>
            </div>

            <!-- 8. Notifications -->
            <div class="dashboard-card">
                <h3>Notifications</h3>
                <p>No new notifications.</p>
            </div>

            <!-- 9. Nearby Services -->
            <div class="dashboard-card">
                <h3>Nearby Services</h3>
                <p>Map preview</p>
            </div>

            <!-- 10. Help & Support -->
            <div class="dashboard-card">
                <h3>Help & Support</h3>
                <ul>
                    <li><a asp-page="/Help/Faq">FAQ</a></li>
                    <li><a asp-page="/Help/Chat">Live Chat</a></li>
                    <li><a asp-page="/Help/Ticket">Submit a Ticket</a></li>
                </ul>
            </div>

            <!-- 11. Usage Trends -->
            <div class="dashboard-card">
                <h3>Usage Trends</h3>
                <p>View detailed stats</p>
            </div>

            <!-- 12. What Others Say -->
            <div class="dashboard-card">
                <h3>What Others Say</h3>
                <blockquote>“Great service—always on time!”</blockquote>
            </div>

            <!-- 13. Resources -->
            <div class="dashboard-card">
                <h3>Resources</h3>
                <ul>
                    <li><a asp-page="/Resources/Guide">Getting Started Guide</a></li>
                    <li><a asp-page="/Resources/Blog">Latest Articles</a></li>
                </ul>
            </div>
        </div>
    </div>
    <script>
        @Html.Raw(App.Scripts.Pages.User.Dashboard.Index.CloseCurrentAddressModal())
        @Html.Raw(App.Scripts.Pages.User.Dashboard.Index.ResetNewAddressInputs())
        @Html.Raw(App.Scripts.Pages.User.Dashboard.Index.CloseNewAddressCard())
        @Html.Raw(App.Scripts.Pages.User.Dashboard.Index.UpdateDefaultAddress())
        @Html.Raw(App.Scripts.Pages.User.Dashboard.Index.DeleteAddressCard())
        @Html.Raw(App.Scripts.Mapbox.AutoCompleteScript(App.Settings.MapboxToken))
    </script>