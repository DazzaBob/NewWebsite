@page
@model Website.Pages.User.Address.ListPartialModel
@using System.Data
@{
    Layout = null;
    var dt = Model.Addresses;
}
@if (dt == null || dt.Rows.Count == 0)
{
    <div class="empty-state">
        <p>No saved addresses yet.</p>
        <div class="mt-3"><a href="/User/Addresses/Add" class="btn btn-link">+ Add New Address</a></div>
    </div>
}
else
{
    @foreach (DataRow row in dt.Rows)
    {
        var id = Convert.ToInt32(row["ID"]);
        var isDefault = Convert.ToInt32(row["ISDEFAULT"]) == 1;
        var label = (row["LABEL"]?.ToString() ?? string.Empty).Trim();

        var streetNo = row["STREET_NUMBER"]?.ToString() ?? string.Empty;
        var streetName = row["STREET_NAME"]?.ToString() ?? string.Empty;
        var street = $"{streetNo} {streetName}".Trim();

        var locality = row["LOCALITY_NAME"]?.ToString() ?? string.Empty;
        var place = row["PLACE_NAME"]?.ToString() ?? string.Empty;
        var placeLine = string.IsNullOrWhiteSpace(locality) ? place : $"{locality}, {place}";

        <div class="card address-card">
            <div class="address-option-row">
                <input class="address-radio" name="selectedAddress" type="radio" id="addr_@id" value="@id" @(isDefault ? "checked" : null) />
                <label class="address-label" for="addr_@id"><b>@label</b></label>
            </div>
            <div class="address-line">@street,&nbsp;@placeLine</div>
        </div>
    }
}
<div id="address-modal">
    <div id="add-address-section" class="mt-3">
        <a id="add-address-link" href="#" role="button" tabindex="0">+ Add New Address</a>
    </div>
    <div id="new-address-card" class="card address-card" style="display:none;">
        <div class="address-option-row">
            <label><b>New Address</b></label>
        </div>

        <div class="form-group mt-2">
            <label for="newLabel">Label</label>
            <input type="text" id="newLabel" class="form-control" placeholder="Home, Work, etc." />
        </div>

        <div class="form-group mt-2">
            <label for="newStreet">Street</label>
            <input type="text" id="newStreet" class="form-control" placeholder="Start typing address..." />
        </div>

        <div class="form-group mt-2">
            <label>
                <input type="checkbox" id="newIsDefault" /> Set as default
            </label>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button id="saveNewAddress" type="button" class="btn btn-primary">Save</button>
            <button id="cancelNewAddress" type="button" class="btn btn-secondary">Cancel</button>
        </div>
    </div>
</div>
