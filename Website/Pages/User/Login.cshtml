@page
@model Website.Pages.User.LoginModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Login";
}
<section class="container">
    <div style="max-width: 400px; margin: 0 auto; padding: 2rem 0;">
        <h1 style="text-align: center; margin-bottom: 1rem;">Log In</h1>

        <form method="post">
            <div style="margin-bottom: 1rem;">
                <label for="email">Email or Mobile</label>
                <input type="text" id="email" name="EmailOrPhone" required />
            </div>

            <div class="password-wrapper" style="margin-bottom: 1rem;">
                <label for="password">Password</label>
                <input type="password" id="password" name="Password" class="input-text" required />
                <button type="button" class="password-toggle" onclick="togglePasswordVisibility()">👁</button>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <span class="error-msg">@Model.ErrorMessage</span>
            }

            <div style="margin-top: 2rem; text-align: center;">
                <button type="submit" class="btn btn-primary">Log In</button>
            </div>
        </form>
    </div>
</section>
<script>
    function togglePasswordVisibility() {
        const pwd = document.getElementById("password");
        pwd.type = pwd.type === "password" ? "text" : "password";
    }
</script>