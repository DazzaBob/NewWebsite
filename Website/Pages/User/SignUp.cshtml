@page
@model Website.Pages.User.SignUpModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "SignUp";

    SelectList AddressOptions = App.Helper.Table.AddressType.AddressTypeOptions();
    string modalId = Guid.NewGuid().ToString("N"); // unique modal identifier
}
<section class="form-page">
    <div class="form-container" style="max-width:500px; margin:0 auto; padding:2rem;">
        <h2 style="text-align:center; margin-bottom:1rem;">Create Your Account</h2>
        <form method="post" class="form-stack" style="display:flex; flex-direction:column; gap:1rem;">
            <div>
                <label asp-for="FullName"></label>
                <span asp-validation-for="FullName" class="error-msg"></span>
                <input asp-for="FullName" id="FullName" class="input-text" autocomplete="name" autofocus required />
            </div>
            <div>
                <label asp-for="Phone"></label>
                <span asp-validation-for="Phone" class="error-msg"></span>
                <input asp-for="Phone" class="input-text" autocomplete="tel" inputmode="numeric" pattern="^(\+64|0)2\d{7,10}$" title="Enter a valid NZ mobile number (e.g. 0212345678)" />
            </div>
            <div>
                <label asp-for="Email"></label>
                <span asp-validation-for="Email" class="error-msg"></span>
                <input asp-for="Email" class="input-text" type="email" autocomplete="email" placeholder="Enter your email" />
            </div>
            <div class="password-wrapper" style="margin-bottom: 1rem;">
                <label asp-for="Password"></label>
                <span asp-validation-for="Password" class="error-msg"></span>
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <input asp-for="Password" id="Password" class="input-text" type="password" autocomplete="new-password" />
                    <button type="button" class="password-toggle" onclick="togglePasswordVisibility()" aria-label="Toggle password visibility">👁</button>
                </div>
            </div>
            <div class="mapbox-address-autofill" style="position:relative;">
                <label>Search Address</label>
                <span asp-validation-for="HJSON" class="error-msg"></span>
                <input id="AS" type="text" class="input-text" autocomplete="off" placeholder="Start typing your address…" required />
                <ul id="CL" hidden></ul>
                <input asp-for="HJSON" id="HJSON" type="hidden" />
            </div>
            <div class="form-field mt-2">
                <label><b>Address Type</b></label>
                <span asp-validation-for="AddressTypeID" class="error-msg"></span>
                <select asp-for="AddressTypeID" asp-items="AddressOptions" class="input-text" required>
                    <option value="">--Select address type--</option>
                    @foreach (SelectListItem item in AddressOptions)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Register</button>
        </form>
    </div>
</section>
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', () => {
    try { if (typeof initMapboxAutocomplete === 'function') { initMapboxAutocomplete('AS', 'CL', 'HJSON'); } else {alert('Autocomplete not loaded.'); } }
    catch (err) { alert('Autocomplete has disabled: ' + err.message); } });
</script>