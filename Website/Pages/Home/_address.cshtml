@using System.Data
@using App.Security
@{
    using DataTable dt = App.Database.DataAccessManager.GetDataTable(App.Database.Schema.Entities.Database, App.Database.Schema.Entities.Tables.UserAddress, $"USER_ID={User.Id()}");
    DataRow[] DR = dt.Select("");

    SelectList AddressOptions = App.Helper.Table.AddressType.AddressTypeOptions();
    string modalId = Guid.NewGuid().ToString("N"); // unique modal identifier
}
<div class="custom-modal" data-modal-type="address" data-modal-id="@modalId">
    <div class="custom-modal-content" role="dialog" aria-modal="true" aria-labelledby="addressmodaltitle_@modalId">
        <!-- Header -->
        <div class="custom-modal-header">
            <input type="hidden" class="AddressModalId" value="@modalId" />
            <h5 id="addressmodaltitle_@modalId">Select Current Address</h5>
            <button class="btn-close" aria-label="Close" onclick="ResetNewAddressInputs(); CloseNewAddressCard(); closeModalByType('address')">×</button>
        </div>

        <!-- Body -->
        <div class="custom-modal-body">
            @if (DR.Length == 0)
            {
                <div class="empty-state">
                    <p>No saved addresses yet.</p>
                </div>
            }
            else
            {
                foreach (DataRow row in DR)
                {
                    long addressId = (long)(row["ADDRESS_ID"]);
                    string userAddressId = (row["ID"]?.ToString() ?? string.Empty).Trim();
                    string label = (row["LABEL"]?.ToString() ?? string.Empty).Trim();
                    long isDefault = (long)row["ISDEFAULT"];
                    @Html.Raw(App.HTML.Pages.Home.IndexPartials.AddressModelAddressCard.Get(modalId, addressId.ToString(), userAddressId, Convert.ToBoolean(isDefault), label));
                }
            }
            
            <!-- Add New Address Section -->
            <div class="mt-3">
                <a href="#" role="button" onclick="var modal=this.closest('.custom-modal');var newCard=modal.querySelector('.new-address-card');if(newCard){newCard.style.display='block';var input=newCard.querySelector('.new-address-label');if(input)input.focus();newCard.scrollIntoView({behavior:'smooth',block:'center'});}return false;">+ Add New Address</a>
            </div>
            <div class="card address-card new-address-card" style="display:none;">
                <div class="add-address-form">
                    <div class="address-option-row">
                        <label><b>New Address</b></label>
                    </div>
                    <br />
                    <div class="form-group mt-2">
                        <label>Label</label>
                        <input id="AMNAL" type="text" class="form-control new-address-label" placeholder="Home, Work, etc." maxlength="25" />
                    </div>
                    <br />
                    <div class="mapbox-address-autofill" style="position:relative;">
                        <label>Search Address</label>
                        <input id="AMNAS" type="text" class="input-text" autocomplete="off" placeholder="Start typing your address…" required />
                        <ul id="AMACL" hidden></ul>
                        <input id="AMHJSON" type="hidden" class="location-payload" />
                    </div>
                    <br />
                    <div class="form-group mt-2">
                        <label>Address Type</label>
                        <select id="AMNATID" class="input-text" style="color: var(--color-text); background-color: var(--color-bg-alt); border: 1px solid var(--color-primary); border-radius: 8px; padding: 0.75rem 1rem; width: 100%; box-sizing: border-box; transition: border-color 0.3s ease, box-shadow 0.3s ease;" required>
                            <option value="">--Select address type--</option>
                            @foreach (SelectListItem item in AddressOptions)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <br />
                    <div class="mt-3">
                        <table style="width: 100%; padding: 0 0 0 0; border-collapse: collapse;">
                            <tr>
                                <td style="width: 50%;"><button id="addressSave" type="button" class="btn btn-primary" onclick="SaveNewAddress(this.closest('.new-address-card'));">Save</button></td>
                                <td style="text-align: right;"><button id="addressCancel" type="button" class="btn btn-secondary" onclick="CloseNewAddressCard();">Cancel</button></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="custom-modal-footer"><span>&nbsp;</span></div>
    </div>
</div>
<script type="text/javascript">
    @Html.Raw(App.Scripts.Mapbox.AutoCompleteScript("AMNAS", "AMACL", "AMHJSON"))
    @Html.Raw(App.HTML.Pages.Home.Modals.Scripts.Address.Script())
</script>