@page
@model Website.Pages.Home.IndexModel
@{
}
<div class="grid-canvas" style="border: 2px solid var(--color-primary); border-radius: var(--radius-medium); width:100%;">
    <div class="grid">
        <div class="card">
            <a href="" onclick="OpenPDModal()" class="btn btn-outline">
                <h3>Request a Driver</h3>
                <i class="fas fa-box"></i><b>&nbsp;Place Order!</b>
            </a>
        </div>
        <div class="card">
            <a href="" onclick="Placeholder" class="btn btn-pill-disabled btn-outline">
                <h3>Catch a Ride</h3>
                <i class="fas fa-car"></i><b>&nbsp;Place Order!</b>
            </a>
        </div>
        <div class="card">
            <a href="/Signup/Partner" class="btn btn-pill-disabled btn-outline">
                <h3>Work With Us</h3>
                <i class="fas fa-briefcase"></i><b>&nbsp;Apply Now!</b>
            </a>
        </div>
    </div>
</div>
<div class="grid-canvas">
    <div class="card">
        <h3>Manage Addresses</h3>
        <ul class="task-list">
            <li><a asp-page="/User/Addresses" class="btn">View / Edit Addresses</a></li>
            <li><a asp-page="/User/Addresses/Add" class="btn">Add New Address</a></li>
            <li><a asp-page="/User/Addresses/Delete" class="btn btn-outline-danger">Remove Address</a></li>
        </ul>
    </div>
    <!-- 1. Account Balance -->
    <div class="card">
        <h3>Account Balance</h3>
        <p>0.00</p>
    </div>
</div>