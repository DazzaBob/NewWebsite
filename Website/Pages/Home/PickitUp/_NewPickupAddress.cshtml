    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
        string modalId = Guid.NewGuid().ToString("N"); // unique modal identifier
}
<div class="custom-modal" data-modal-type="newpickupaddress" data-modal-id="@modalId">
    <div class="custom-modal-content" role="dialog" aria-modal="true">
        <div class="custom-modal-header" style="display: flex; justify-content: flex-end; align-items: center; padding: 0.25rem;">
            <button id="NPAMBTNCLS" class="btn btn-close" aria-label="Close">×</button>
        </div>
        <div class="custom-modal-body">
            @Html.Raw(App.StringBuilders.Pages.AddNewAddressCard.GenerateAddressCard("NPAMCI", "NPAMNAL", "NPAMNAS", "NPAMACL", "NPAMHJSON", "NPAMNATC", "NPAMNATID", "NPAMBtnCls();", "(async () => { await SaveNewAddressFlexible(this); await InsertLastAddress(this); NPAMBtnCls();})(); "))
        </div>
    </div>
</div>
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', () => {
    try { if (typeof initMapboxAutocomplete === 'function') { initMapboxAutocomplete('NPAMNAS', 'NPAMACL', 'NPAMHJSON'); } else {alert('Autocomplete not loaded.'); } }
    catch (err) { alert('Autocomplete is disabled: ' + err.message); } });
</script>