@using System.Data
@using App.Security
@{
    using DataTable DT = App.Database.Views.UserAddress.DataTable(User.Id());
    DataRow[] DR = DT.Select("");

    SelectList AddressOptions = App.Helper.Table.AddressType.AddressTypeOptions();
    string modalId = Guid.NewGuid().ToString("N"); // unique modal identifier
}
<div class="custom-modal" data-modal-type="address" data-modal-id="@modalId">
    <div class="custom-modal-content" role="dialog" aria-modal="true" aria-labelledby="addressmodaltitle_@modalId">
        <!-- Header -->
        <div class="custom-modal-header">
            <input type="hidden" class="AddressModalId" value="@modalId" />
            <h5 id="addressmodaltitle_@modalId">Select Current Address</h5>
            <button id="AMBTNCLS" class="btn btn-close" aria-label="Close">×</button>
        </div>

        <!-- Body -->
        <div class="custom-modal-body">
            @if (DR.Length == 0)
            {
                <div class="empty-state">
                    <p>No saved addresses yet.</p>
                </div>
            }
            else
            {
                foreach (DataRow row in DR)
                {
                    int addressId = (int)(row["ADDRESS_ID"]);
                    string userAddressId = (row["ID"]?.ToString() ?? string.Empty).Trim();
                    string label = (row["LABEL"]?.ToString() ?? string.Empty).Trim();
                    bool isDefault = (bool)row["ISDEFAULT"];
                    @Html.Raw(App.StringBuilders.Pages.Index.Modals.Address.AddressCard.Get(modalId, addressId.ToString(), userAddressId, isDefault, label))
                }
            }
            <!-- Add New Address Section -->
            <div class="mt-3">
                <button type="button" class="btn btn-pill btn-outline nav" onclick="var modal=this.closest('.custom-modal');var newCard=modal.querySelector('.new-address-card');if(newCard){newCard.style.display='block';var input=newCard.querySelector('.new-address-label');if(input)input.focus();newCard.scrollIntoView({behavior:'smooth',block:'center'});}return false;">+ Add New Address</button>
            </div>
            @Html.Raw(App.StringBuilders.Pages.AddNewAddressCard.GenerateAddressCard("AMCI", "AMNAL", "AMNAS", "AMACL", "AMHJSON", "AMNATC", "AMNATID"))
        </div>
        <div class="custom-modal-footer"><span>&nbsp;</span></div>
    </div>
</div>
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', () => {
    try { if (typeof initMapboxAutocomplete === 'function') { initMapboxAutocomplete('AMNAS', 'AMACL', 'AMHJSON'); } else {alert('Autocomplete not loaded.'); } }
    catch (err) { alert('Autocomplete is disabled: ' + err.message); } });
</script>