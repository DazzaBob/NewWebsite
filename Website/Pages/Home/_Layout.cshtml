<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - That's Handy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/site.css" />
    <meta name="t" content="@App.Settings.MapboxToken" />
</head>
<body>
    <table style="width: 100%; height: 100dvh; border-collapse: collapse;">
        <thead><tr style="height:auto;"><td colspan="1"><partial name="~/Pages/Home/Index/_Header.cshtml" /></td></tr></thead>
        <tbody style="display: block; overflow-y: auto; height: calc(100dvh - 200px); width: 100%;"><tr style="display: table; table-layout: fixed; width: 100%;"><td style="width: 100%;">@RenderBody()</td></tr></tbody>
        <tfoot><tr><td colspan="1"><partial name="~/Pages/Home/Index/_Footer.cshtml" /></td></tr></tfoot>
    </table>
    <partial name="~/Pages/Home/Index/_address.cshtml" />
    <partial name="~/Pages/Home/Index/_location.cshtml" />
    <script src="/js/site.js" defer asp-append-version="true"></script>
</body>
</html>
