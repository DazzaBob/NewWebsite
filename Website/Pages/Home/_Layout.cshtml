@using Microsoft.AspNetCore.Http
@using Website.App.Security;
@inject IHttpContextAccessor HttpContextAccessor
@{
    using App.Helper.Connection EntitiesConnection = App.Database.Shared.Connection(App.Database.Schema.Entities.Database);
    using App.Helper.Connection LocationsConnection = App.Database.Shared.Connection(App.Database.Schema.Locations.Database);
    int userId = User.Id();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - That's Handy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="preload" href="/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="/css/all.min.css"></noscript>
    <link rel="preload" href="/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/elements.css" />
    <link rel="stylesheet" href="/css/Home.css" />
    <link rel="stylesheet" href="/css/mapbox.css" />
    <meta name="t" content="@App.Settings.MapboxToken" />
</head>
<body>
    <table style="width: 100%; height: 100dvh; border-collapse: collapse;">
        <thead><tr style="height:auto;"><td colspan="1"><partial name="~/Pages/Home/Index/_Header.cshtml" /></td></tr></thead>
        <tbody style="display: block; overflow-y: auto; height: calc(100dvh - 200px); width: 100%;"><tr style="display: table; table-layout: fixed; width: 100%;"><td style="width: 100%;">@RenderBody()</td></tr></tbody>
        <tfoot>
            <tr>
                <td colspan="1">
                    <partial name="~/Pages/Home/Index/_Footer.cshtml" />
                </td>
            </tr>
        </tfoot>
    </table>
    <partial name="~/Pages/Home/_address.cshtml" />
    @Html.Raw(App.HTML.Pages.Home.Index.LocationModal(EntitiesConnection, LocationsConnection, userId))
    @Html.Raw(App.HTML.Pages.Home.Index.DeliveryModal(EntitiesConnection, LocationsConnection, userId))

    <script src="/js/site.js" defer asp-append-version="true"></script>
@* JS for this page only *@
    <script src="~/js/home/Orchestrator.js" defer asp-append-version="true"></script>
    <script src="~/js/home/LocationModal.js" defer asp-append-version="true"></script>
    <script src="~/js/home/DeliveryModal.js" defer asp-append-version="true"></script>
</body>
</html>
