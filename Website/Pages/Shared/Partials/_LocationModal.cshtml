@using System.Data
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor Http
<form id="locationForm">
    <div id="locationModal" class="custom-modal" style="display:none">
        <div class="custom-modal-content" role="dialog" aria-modal="true" aria-labelledby="locationModalTitle" tabindex="-1">
            <div class="custom-modal-header">
                <h5 id="locationModalTitle">Current Location</h5>
                <button id="locationClose" type="button" class="btn-close" aria-label="Close">×</button>
            </div>

            <div class="location-modal-body">
                <div class="card address-card">
                    <div class="address-option-row" style="align-items:flex-start">
                        <label class="address-label"><b>Resolved Address</b></label>
                    </div>
                    <div id="locationPreview" class="address-line">(not loaded yet)</div>
                </div>

                <span>&nbsp;</span>

                <div class="card address-card">
                    <div class="address-option-row">
                        <label for="locationAddressTypeId" class="address-label"><b>Address Type</b></label>
                    </div>
                    <div class="address-line">
                        <select id="locationAddressTypeId" name="addressTypeID" class="input">
                            <option value="">Select address type…</option>
                            <option value="1">Residential</option>
                            <option value="2">Commercial</option>
                            <option value="3">Industrial</option>
                            <option value="4">Mixed-Use</option>
                            <option value="5">Institutional / Public</option>
                            <option value="6">Agricultural</option>
                            <option value="7">Special Purpose</option>
                        </select>
                        <div id="locationTypeError" class="field-error" aria-live="polite"></div>
                    </div>
                </div>
            </div>

            <div class="custom-modal-footer">
                <button id="locationCancel" type="button" class="btn btn-secondary">Cancel</button>
                <button id="locationSave" type="submit" class="btn btn-primary" disabled>Save</button>
            </div>
        </div>
    </div>
</form>