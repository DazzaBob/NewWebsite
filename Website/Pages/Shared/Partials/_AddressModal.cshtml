@using System.Data
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor Http
<form id="addressForm">
    <div id="addressModal" class="custom-modal" style="display:none">
        <div class="custom-modal-content" role="dialog" aria-modal="true" aria-labelledby="addressModalTitle" tabindex="-1">
            <div class="custom-modal-header">
                <h5 id="addressModalTitle">Select Current Address</h5>
                <button id="addressClose" class="btn-close" aria-label="Close">×</button>
            </div>
            <div class="custom-modal-body">
            </div>
            <div class="custom-modal-footer">
                <button id="addressCancel" class="btn btn-secondary">Cancel</button>
                <button id="addressSave" type="submit" class="btn btn-primary">Set as current</button>
            </div>
        </div>
    </div>
</form>