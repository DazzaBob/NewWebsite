@using Microsoft.AspNetCore.Http
@using Website.App.Security;
@inject IHttpContextAccessor HttpContextAccessor
@{
    int userId = User.Id();
    string currentPath = (HttpContextAccessor.HttpContext?.Request.Path.Value ?? "").Trim().TrimEnd('/').ToLower();
}
<header class="site-header">
    <div class="header-container">
        <div class="logo" style="flex:0 0 auto; margin-right:2rem;">
            <a href="/Index"><img src="/assets/images/logo_96.png" alt="" height="40" style="display:block;" /></a>
        </div>
        <nav class="nav-links"> 
            @if (userId > 0) 
            { // Logged in
              <a href="/home" onclick="setHomeContext('initial')">Home</a>
            <a href="/Account/Settings">Settings</a>
              <a href="/User/Logout" class="btn btn-outline">Logout</a>
     }
            else { // Not logged in
                if (currentPath != "/user/login")
                {
                    <a href="/home" onclick="setHomeContext('login')" class="btn btn-outline">Log In</a>
                }
                if (currentPath != "/user/signup")
                {
                    <a href="/home" onclick="setHomeContext('signup')" class="btn btn-outline">Sign Up</a>
                }
                    <a href="/Faq">FAQ</a>
            }
        </nav>
    </div>
</header>
<script>
    function setHomeContext(ctx) {
        // store the intent for just this transition
        sessionStorage.setItem("home_context", ctx);
    }
</script>