@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    bool IsDashboard = App.Helper.Shared.IsDashboard(HttpContextAccessor.HttpContext?.Request.Path.Value?.ToLower() ?? "");
    using App.Helper.Connection EntitiesConnection = App.Database.Shared.Connection(App.Database.Schema.Entities.Database);
    using App.Helper.Connection LocationsConnection = App.Database.Shared.Connection(App.Database.Schema.Locations.Database);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - That's Handy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @if (IsDashboard)
    {
        <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
        <meta name="Website-mapbox-token" content="@App.Settings.MapboxToken" />
    }
</head>
<body>
    <header class="site-header">
        <partial name="~/Pages/Shared/_Header.cshtml" />
    </header>

    @* Dashboard modals outside header, only if on dashboard *@
    @if (IsDashboard)
    {
        @Html.Raw(App.HTML.Pages.Dashboard.Index.AddressModal(EntitiesConnection, LocationsConnection, Model.UserId))
        ;
        <partial name="~/Pages/Shared/Partials/_LocationModal.cshtml" />
    }

    <main role="main" class="@(IsDashboard ? "dashboard-content" : "container")">
        @RenderSection("StatusStrip", required: false)
        @RenderBody()
    </main>

    <div id="globalSpinner" class="spinner-overlay" hidden>
        <div class="spinner spinner--lg" aria-hidden="true"></div>
    </div>

    <partial name="_Footer" />

    @* Global JS for all pages *@
    <script src="~/js/GS.js" defer asp-append-version="true"></script>

    <script src="~/js/Site.js" defer asp-append-version="true"></script>
    @* Dashboard JS only if dashboard *@
    @if (IsDashboard)
    {
        var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
        bool isDashboardIndex = currentPath == "/user/dashboard";
        
        if (isDashboardIndex)
        {
            <script src="~/js/DUAddress.js" defer asp-append-version="true"></script>
        }
        <script src="~/js/dashboards/user/currentlocation.js" defer asp-append-version="true"></script>
        <script src="~/js/dashboard.js" defer asp-append-version="true"></script>
    }

    @RenderSection("Scripts", required: false)
</body>
</html>