<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - That's Handy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/site.css" />
    <meta name="t" content="@App.Settings.MapboxToken" />
</head>
<body>
    <partial name="~/Pages/Shared/_Header.cshtml" />
    <main role="main" class="site-main">
        @RenderSection("StatusStrip", required: false)
        @RenderBody()
    </main>
    <partial name="~/Pages/Shared/_Footer.cshtml" />
    <script src="/js/site.js" defer asp-append-version="true"></script>
</body>
</html>