<!-- AT_PICKUP -->
<section class="driver-job__stage driver-job__stage--AT_PICKUP"
         data-stage="AT_PICKUP">
    <header class="driver-job__stage-header">
        <h6>At pickup</h6>
        <p>
            Confirm the order details with the staff, collect the items,
            and get ready to start the delivery.
        </p>
    </header>

    <ul class="driver-job__checklist">
        <li>Confirm name and reference on the order.</li>
        <li>Check items are sealed / ready for transport.</li>
        <li>Secure the items in your vehicle.</li>
    </ul>

    <div class="driver-job__stage-actions">
        <button type="button"
                class="btn btn-primary driver-job__btn-primary js-driver-job-picked-up">
            Order picked up
        </button>
    </div>
</section>