<!-- STAGE-SPECIFIC CONTENT (ALL AS PLACEHOLDERS) -->
<!-- ASSIGNED / EN_ROUTE_PICKUP -->
<section class="driver-job__stage driver-job__stage--ASSIGNED"
         data-stage="ASSIGNED">
    <header class="driver-job__stage-header">
        <h6>Head to pickup</h6>
        <p>
            Navigate to the pickup location and head inside when you arrive.
        </p>
    </header>

    <div class="driver-job__stage-actions">
        <button type="button"
                class="btn btn-primary driver-job__btn-primary js-driver-job-navigate-pickup">
            Navigate to pickup
        </button>

        <button type="button"
                class="btn btn-outline driver-job__btn-secondary js-driver-job-arrived-pickup">
            I’ve arrived at pickup
        </button>
    </div>
</section>