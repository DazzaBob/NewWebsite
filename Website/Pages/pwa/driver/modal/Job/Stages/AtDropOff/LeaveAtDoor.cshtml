<!-- AT_DROPOFF – LEAVE_AT_DOOR -->
<section class="driver-job__stage driver-job__stage--AT_DROPOFF-LEAVE_AT_DOOR"
         data-stage="AT_DROPOFF"
         data-dropoff="LEAVE_AT_DOOR">
    <header class="driver-job__stage-header">
        <h6>At dropoff – leave at door</h6>
        <p>
            Follow the customer’s dropoff preference below.
        </p>
    </header>

    <div class="driver-job__dropoff-instructions">
        <strong>Leave at the door</strong>
        <p>
            Leave the package in a safe, visible spot at the door.
            Take a clear photo as proof of delivery.
        </p>
    </div>

    <div class="driver-job__stage-actions">
        <button type="button"
                class="btn btn-outline driver-job__btn-secondary js-driver-job-take-photo">
            Take photo
        </button>

        <button type="button"
                class="btn btn-primary driver-job__btn-primary js-driver-job-complete-delivery">
            Complete delivery
        </button>
    </div>
</section>