<!-- AT_DROPOFF – HAND_TO_RECIPIENT -->
<section class="driver-job__stage driver-job__stage--AT_DROPOFF-HAND_TO_RECIPIENT"
         data-stage="AT_DROPOFF"
         data-dropoff="HAND_TO_RECIPIENT">
    <header class="driver-job__stage-header">
        <h6>At dropoff – hand to recipient</h6>
        <p>
            Follow the customer’s dropoff preference below.
        </p>
    </header>

    <div class="driver-job__dropoff-instructions">
        <strong>Hand it to recipient</strong>
        <p>
            Meet the customer at the door and hand the package directly to them.
            If requested, confirm their name before handing over.
        </p>
    </div>

    <div class="driver-job__stage-actions">
        <button type="button"
                class="btn btn-primary driver-job__btn-primary js-driver-job-complete-delivery">
            Handed to recipient
        </button>
    </div>
</section>