<!-- EN_ROUTE_DROPOFF -->
<section class="driver-job__stage driver-job__stage--EN_ROUTE_DROPOFF"
         data-stage="EN_ROUTE_DROPOFF">
    <header class="driver-job__stage-header">
        <h6>Head to dropoff</h6>
        <p>
            Use navigation to reach the dropoff location, then follow the
            customer’s delivery instructions.
        </p>
    </header>

    <div class="driver-job__stage-actions">
        <button type="button"
                class="btn btn-primary driver-job__btn-primary js-driver-job-navigate-dropoff">
            Navigate to dropoff
        </button>

        <button type="button"
                class="btn btn-outline driver-job__btn-secondary js-driver-job-arrived-dropoff">
            I’ve arrived at dropoff
        </button>
    </div>
</section>