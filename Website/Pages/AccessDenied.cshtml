@page
@model Website.Pages.AccessDeniedModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Access Denied";
}
<style>
    @@keyframes flash {
        0%, 50%, 100% { opacity: 1; }

        25%, 75% { opacity: 0;}
    }

    .flash {
        animation: flash 2.0s steps(1,end) infinite;
    }
</style>

<section style="text-align:center; padding:3rem 1rem;">
    <h1 class="flash" style="color: #c0392b; font-size:2.5rem; margin-bottom:1rem; opacity:1;">
        ACCESS DENIED
    </h1>
    <p style="font-size:1.2rem; margin-bottom:2rem;">
        You don’t have permission to view this page.
    </p>
    <a asp-page="/Index" class="btn btn-primary" style="padding:0.75rem 1.5rem; font-size:1rem;">
        Return to Home
    </a>
</section>